{
  "manifest_version": 3,
  "name": "Stash \u2014 Tab Collections",
  "version": "1.6.0",
  "description": "Save tabs into collapsible collections. A minimal bookmark manager for Helium.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Stash",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Stash"
    }
  },
  "chrome_url_overrides": {
    "newtab": "manager.html"
  }
}